# Copy to `.env.local` (git-ignored) and fill in:  cp .env.example .env.local
# Empty or missing → sensible local defaults.

# Public URL of the site (canonical URLs, sitemap, OG images), e.g. https://your-domain.com
NEXT_PUBLIC_SITE_URL=
# FastAPI backend (chatbot). Empty → same host as the page, port 8000.
NEXT_PUBLIC_API_URL=
# Extra hostnames allowed to open the dev server (comma-separated)
DEV_ALLOWED_ORIGINS=
