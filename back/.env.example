# Copy to `.env` (git-ignored) and fill in what you need:  cp .env.example .env
# Every variable is optional: empty or missing → default from app/core/config.py.

# --- App ----------------------------------------------------------------------
# development | production | test   (development also allows CORS from your LAN)
ENVIRONMENT=
# DEBUG | INFO | WARNING
LOG_LEVEL=
# JSON list of allowed web origins, e.g. ["https://your-domain.com"]
CORS_ORIGINS=
# Extra allowed origins as a regex (empty = LAN in development, none in production)
CORS_ORIGIN_REGEX=

# --- Chat model -----------------------------------------------------------------
# ollama | openai | anthropic | groq | gemini | openrouter
LLM_PROVIDER=
# e.g. qwen2.5:3b (ollama) · gpt-4o-mini (openai) · claude-haiku-4-5-20251001 (anthropic)
LLM_MODEL=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
# Optional cheaper/faster model only for the scope router (e.g. qwen2.5:0.5b)
CLASSIFIER_MODEL=

# --- Fallback chain (production on free tiers) ---------------------------------
# Ordered "provider:model, …". Overrides LLM_PROVIDER/LLM_MODEL. A model that hits its
# rate limit or daily quota, errors or is too slow is skipped for a while and the next
# one answers. Options after "?": reasoning_effort=none|low|medium|high.
# Check every entry with: uv run --extra openai python -m evals.check_llms
# e.g. groq:openai/gpt-oss-120b?reasoning_effort=low, groq:qwen/qwen3.8-27b, gemini:gemini-3.5-flash-lite, openrouter:nvidia/nemotron-3-super-120b-a12b:free
LLM_CHAIN=
# Chain for the scope router only (empty = LLM_CHAIN), e.g. groq:qwen/qwen3.8-27b, gemini:gemini-3.5-flash-lite
CLASSIFIER_CHAIN=
# Router output tokens (8). Reasoning models think first: raise it (e.g. 256) for them
CLASSIFIER_MAX_TOKENS=
# Max wait for a model's first token before trying the next one (20)
LLM_ATTEMPT_TIMEOUT_SECONDS=
# How long a failed model is skipped: per-minute limit (60) · daily quota/bad key (3600) · error (30)
LLM_COOLDOWN_RATE_LIMIT_SECONDS=
LLM_COOLDOWN_QUOTA_SECONDS=
LLM_COOLDOWN_ERROR_SECONDS=

# --- Embeddings -----------------------------------------------------------------
# ollama | openai | gemini
EMBEDDING_PROVIDER=
# e.g. nomic-embed-text (ollama) · text-embedding-3-small (openai) · gemini-embedding-001 (gemini)
EMBEDDING_MODEL=
# Smaller vectors for models that support it (gemini-embedding-001: 3072 → e.g. 768)
EMBEDDING_DIMENSIONS=
# Max seconds to embed a question; on failure retrieval uses keyword search (BM25) only
EMBEDDING_TIMEOUT_SECONDS=
# Only to override the automatic task prefixes (nomic-embed-* get them by default)
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

# --- Provider endpoints & secrets -------------------------------------------------
# e.g. http://localhost:11434
OLLAMA_BASE_URL=
# seconds a model stays loaded in memory
OLLAMA_KEEP_ALIVE=
OPENAI_API_KEY=
# Any OpenAI-compatible server (Groq, Together, vLLM, LM Studio…), e.g. https://api.groq.com/openai/v1
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# Free tiers (OpenAI-compatible; need `--extra openai`): console.groq.com · aistudio.google.com · openrouter.ai
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- RAG ------------------------------------------------------------------------
RETRIEVAL_TOP_K=
RETRIEVAL_MIN_SCORE=
RETRIEVAL_LEXICAL_MIN_SCORE=
# only used when the scope classifier is down
RETRIEVAL_OVERRIDE_SCORE=
FOLLOWUP_MAX_TERMS=
# true | false — (re)index knowledge/ on startup when it changed
AUTO_INGEST=

# --- Guardrails -----------------------------------------------------------------
MAX_MESSAGE_CHARS=
MAX_HISTORY_TURNS=
MAX_CONCURRENT_CHATS=
CHAT_QUEUE_SECONDS=
LLM_TIMEOUT_SECONDS=
RATE_LIMIT_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=
