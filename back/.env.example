# Copy to `.env` (git-ignored) and fill in what you need:  cp .env.example .env
# Every variable is optional: empty or missing → default from app/core/config.py.

# --- App ----------------------------------------------------------------------
# development | production | test   (development also allows CORS from your LAN)
ENVIRONMENT=
# DEBUG | INFO | WARNING
LOG_LEVEL=
# JSON list of allowed web origins, e.g. ["https://your-domain.com"]
CORS_ORIGINS=
# Extra allowed origins as a regex (empty = LAN in development, none in production)
CORS_ORIGIN_REGEX=

# --- Chat model -----------------------------------------------------------------
# ollama | openai | anthropic
LLM_PROVIDER=
# e.g. qwen2.5:3b (ollama) · gpt-4o-mini (openai) · claude-haiku-4-5-20251001 (anthropic)
LLM_MODEL=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
# Optional cheaper/faster model only for the scope router (e.g. qwen2.5:0.5b)
CLASSIFIER_MODEL=

# --- Embeddings -----------------------------------------------------------------
# ollama | openai
EMBEDDING_PROVIDER=
# e.g. nomic-embed-text (ollama) · text-embedding-3-small (openai)
EMBEDDING_MODEL=
# Only to override the automatic task prefixes (nomic-embed-* get them by default)
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

# --- Provider endpoints & secrets -------------------------------------------------
# e.g. http://localhost:11434
OLLAMA_BASE_URL=
# seconds a model stays loaded in memory
OLLAMA_KEEP_ALIVE=
OPENAI_API_KEY=
# Any OpenAI-compatible server (Groq, Together, vLLM, LM Studio…), e.g. https://api.groq.com/openai/v1
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# --- RAG ------------------------------------------------------------------------
RETRIEVAL_TOP_K=
RETRIEVAL_MIN_SCORE=
RETRIEVAL_LEXICAL_MIN_SCORE=
# only used when the scope classifier is down
RETRIEVAL_OVERRIDE_SCORE=
FOLLOWUP_MAX_TERMS=
# true | false — (re)index knowledge/ on startup when it changed
AUTO_INGEST=

# --- Guardrails -----------------------------------------------------------------
MAX_MESSAGE_CHARS=
MAX_HISTORY_TURNS=
MAX_CONCURRENT_CHATS=
CHAT_QUEUE_SECONDS=
LLM_TIMEOUT_SECONDS=
RATE_LIMIT_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=
